<IfModule mod_rewrite.c>
  RewriteEngine on

  # === PUENTE TEMPORAL DE MIGRACION A LARAVEL (Fase 1) ===
  # El arbol legacy se movio a legacy/. Mientras Laravel no este instalado
  # en la raiz (Tarea 3+) y el LegacyBridgeController no tome el control
  # (Tarea 7), estas reglas apuntan exactamente donde antes apuntaba
  # "public/", pero dentro de legacy/, para no cortar el servicio.
  # Al completar la Tarea 7 esto se reemplaza por el public/ de Laravel.

  # Scripts sueltos que viven en legacy/ (no en legacy/public/): login,
  # logout y los ajax_*.php que se invocan por URL directa. Sin esta regla
  # quedan 404/servidos por Dashboard en vez de por si mismos.
  RewriteRule ^(login\.php|logout\.php|logout_force\.php|ajax_info_viaje\.php|ajax_mapa\.php)$ legacy/$1 [L]

  # Root always goes to legacy/public/ (MVC Dashboard)
  RewriteRule ^$ legacy/public/ [L]

  # Other requests: if it's not a real file/dir, rewrite to legacy/public/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule (.*) legacy/public/$1 [L]
</IfModule>

# ===================================================
# CONTROL DE CACHÉ PARA ARCHIVOS ESTÁTICOS
# ===================================================
# Solución al problema de caché en navegadores
# Los archivos CSS y JS se recargarán siempre desde el servidor

<IfModule mod_headers.c>
  # Desactivar caché para archivos CSS y JS durante desarrollo
  <FilesMatch "\.(css|js)$">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
  </FilesMatch>
  
  # NOTA: Para producción, comentar lo anterior y descomentar lo siguiente:
  # <FilesMatch "\.(css|js)$">
  #     Header set Cache-Control "max-age=31536000, public"
  # </FilesMatch>
</IfModule>
