<IfModule mod_rewrite.c>
  RewriteEngine on

  # Passthrough interno hacia el legacy (ver LegacyBridgeController): fuerza
  # a que legacy/public/index.php se ejecute como archivo real, en un
  # hilo/proceso de Apache sin nada de Laravel cargado.
  # SOLO desde loopback: el bridge siempre llama a 127.0.0.1, asi que
  # nadie de afuera puede saltarse Laravel entrando por /__legacy.
  RewriteCond %{REMOTE_ADDR} ^(127\.0\.0\.1|::1)$
  RewriteRule ^__legacy/(.*)$ legacy/$1 [L]

  # Re-entrada tras una reescritura interna (la de arriba): dejar pasar.
  RewriteCond %{ENV:REDIRECT_STATUS} !^$
  RewriteRule ^ - [L]

  # Todo request externo va a public/ (Laravel), exista o no como archivo en
  # la raiz. Con Laravel instalado aqui, la raiz contiene .env, composer.json,
  # config/, routes/, database/, storage/, vendor/, legacy/, backups/, etc.:
  # nada de eso debe ser accesible por URL. Los assets reales viven en public/.
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
  </FilesMatch>
</IfModule>
