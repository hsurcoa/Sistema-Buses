<IfModule mod_rewrite.c>
  RewriteEngine on

  # Todo request externo va a public/ (Laravel), exista o no como archivo en
  # la raiz. Con Laravel instalado aqui, la raiz contiene .env, composer.json,
  # config/, routes/, database/, storage/, vendor/, backups/, etc.: nada de
  # eso debe ser accesible por URL. Los assets reales viven en public/.
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
  </FilesMatch>
</IfModule>
