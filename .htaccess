<IfModule mod_rewrite.c>
  RewriteEngine on

  # === REVERTIDO TEMPORALMENTE (ver commit "Fase 1 - Tarea 7: bridge...") ===
  # Se detecto que el front controller de Laravel devuelve respuestas con
  # body vacio en este entorno Apache/mod_php (bajo investigacion, no es
  # bug del codigo: hasta un Route::get() trivial sin vistas ni sesion
  # reproduce el problema). Mientras se resuelve, el sitio real sigue
  # sirviendose 100% desde legacy/ para no afectar el uso en curso.

  RewriteRule ^(login\.php|logout\.php|logout_force\.php|ajax_info_viaje\.php|ajax_mapa\.php)$ legacy/$1 [L]

  RewriteRule ^$ legacy/public/ [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule (.*) legacy/public/$1 [L]
</IfModule>

# ===================================================
# CONTROL DE CACHÉ PARA ARCHIVOS ESTÁTICOS
# ===================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
      Header set Cache-Control "no-cache, no-store, must-revalidate"
      Header set Pragma "no-cache"
      Header set Expires "0"
  </FilesMatch>
</IfModule>
