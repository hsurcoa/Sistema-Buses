                                            <div class="d-flex align-items-baseline text-primary fw-bold">
                                                <span class="fs-4 me-1">Bs.</span>
                                                <!-- Input de precio camuflado como texto grande editable -->
                                                <input type="number" step="0.50" id="edit_precio_display"
