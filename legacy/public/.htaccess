<IfModule mod_rewrite.c>
  Options -Multiviews
  RewriteEngine On

  # Migracion Laravel (Fase 1): este public/ ya no se sirve directo. Solo se
  # llega aqui via la reescritura interna /__legacy (loopback, ver .htaccess
  # raiz y LegacyBridgeController). Un acceso externo directo a
  # /venta-pasajes/legacy/... se rechaza para que nadie se salte Laravel.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ - [F]

  RewriteBase /venta-pasajes/legacy/public
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule  ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
